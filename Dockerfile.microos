ARG OPENSUSE=opensuse/leap:15
FROM ${OPENSUSE} AS build

RUN zypper install -y rpm-build git jq rpmdevtools systemd

ENV SOURCE=/source RPM_OS=microos

WORKDIR ${SOURCE}

COPY . .

ARG COMBARCH
ARG TAG
ARG SCRIPT=build

RUN bash ${SOURCE}/rpm/scripts/entry.sh "${SCRIPT}"

FROM scratch AS result
ENV SOURCE=/source

COPY --from=build ${SOURCE}/dist /dist
